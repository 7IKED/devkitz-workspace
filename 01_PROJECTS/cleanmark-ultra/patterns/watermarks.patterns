# CleanMark Ultra™ — watermarks.patterns
# ═══════════════════════════════════════════════════════════════
# Modulares Pattern-Format fuer Wasserzeichen-Erkennung
# Version: 1.0.0
# Kompatibel mit: CleanMark Ultra Detection Engine
#
# FORMAT:
#   [SECTION]     → Kategorie
#   type:         → text | logo | frequency | metadata | neural
#   id:           → Eindeutige Pattern-ID
#   name:         → Menschenlesbarer Name
#   domain:       → image | video | audio | all
#   method:       → regex | hash | frequency | model | metadata
#   pattern:      → Regex, Hash-Wert, Frequenz-Range, oder Modell-Ref
#   confidence:   → Mindest-Konfidenz fuer Match (0.0-1.0)
#   action:       → detect | remove | strip | flag
#   severity:     → low | medium | high | critical
#   notes:        → Beschreibung
#
# Kommentare beginnen mit #
# Leerzeilen werden ignoriert
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# SECTION: Stock-Foto-Plattformen
# ─────────────────────────────────────────────

[pattern]
type: text
id: STK-001
name: Shutterstock Watermark
domain: image
method: regex
pattern: (?i)shutterstock\.?\s*(images?|inc\.?|\.com)?
confidence: 0.85
action: detect+remove
severity: high
notes: Shutterstock Logo + Text, semi-transparent tiled

[pattern]
type: logo
id: STK-002
name: Shutterstock Logo Hash
domain: image
method: hash
pattern: phash:d4c8b8f0e0c0a080|dhash:8c9cbcb4b4343424
confidence: 0.90
action: detect+remove
severity: high
notes: Perceptual Hash des Shutterstock-Logos (verschiedene Groessen)

[pattern]
type: text
id: STK-003
name: Getty Images Watermark
domain: image
method: regex
pattern: (?i)(getty\s*images?|gettyimages\.com|©\s*getty)
confidence: 0.85
action: detect+remove
severity: high
notes: Getty Images Text-Overlay in verschiedenen Positionen

[pattern]
type: text
id: STK-004
name: Adobe Stock Watermark
domain: image
method: regex
pattern: (?i)(adobe\s*stock|stock\.adobe\.com)
confidence: 0.85
action: detect+remove
severity: high
notes: Adobe Stock Logo und Text

[pattern]
type: text
id: STK-005
name: iStock Watermark
domain: image
method: regex
pattern: (?i)(istock(photo)?\.com|©\s*istock)
confidence: 0.85
action: detect+remove
severity: high
notes: iStockPhoto Wasserzeichen

[pattern]
type: text
id: STK-006
name: Dreamstime Watermark
domain: image
method: regex
pattern: (?i)(dreamstime\.com|©\s*dreamstime)
confidence: 0.85
action: detect+remove
severity: high
notes: Dreamstime diagonaler Text + ID-Nummer

[pattern]
type: text
id: STK-007
name: 123RF Watermark
domain: image
method: regex
pattern: (?i)(123rf\.com|©\s*123rf|123\s*royalty\s*free)
confidence: 0.85
action: detect+remove
severity: high
notes: 123RF tiled Watermark

[pattern]
type: text
id: STK-008
name: Alamy Watermark
domain: image
method: regex
pattern: (?i)(alamy\.com|©\s*alamy|alamy\s*(stock|images?))
confidence: 0.85
action: detect+remove
severity: high
notes: Alamy Logo-Overlay

[pattern]
type: text
id: STK-009
name: Depositphotos Watermark
domain: image
method: regex
pattern: (?i)(depositphotos\.com|©\s*depositphotos)
confidence: 0.85
action: detect+remove
severity: high
notes: Depositphotos diagonaler Text

[pattern]
type: text
id: STK-010
name: Pond5 Watermark
domain: video
method: regex
pattern: (?i)(pond5\.com|©\s*pond5|pond\s*five)
confidence: 0.85
action: detect+remove
severity: high
notes: Pond5 Video-Wasserzeichen

# ─────────────────────────────────────────────
# SECTION: Video-Plattformen / Apps
# ─────────────────────────────────────────────

[pattern]
type: text
id: VID-001
name: TikTok Watermark
domain: video
method: regex
pattern: (?i)(tiktok\.com|@[a-z0-9_\.]+\s*\|\s*tiktok|tik\s*tok)
confidence: 0.80
action: detect+remove
severity: high
notes: TikTok Username + Logo, typisch unten rechts

[pattern]
type: logo
id: VID-002
name: TikTok Logo Hash
domain: video
method: hash
pattern: phash:f0e0c0c0e0f0f8fc|dhash:0030787c3c1c0c00
confidence: 0.88
action: detect+remove
severity: high
notes: TikTok Noten-Logo, verschiedene Groessen

[pattern]
type: text
id: VID-003
name: CapCut Watermark
domain: video
method: regex
pattern: (?i)(capcut\.com|cap\s*cut|edited?\s*(with|in|by)\s*capcut)
confidence: 0.85
action: detect+remove
severity: high
notes: CapCut-Branding am Ende oder als Overlay

[pattern]
type: text
id: VID-004
name: InShot Watermark
domain: video
method: regex
pattern: (?i)(inshot\.com|inshot\s*app|made\s*with\s*inshot)
confidence: 0.85
action: detect+remove
severity: high
notes: InShot Logo, typisch unten rechts

[pattern]
type: text
id: VID-005
name: Canva Watermark
domain: image
method: regex
pattern: (?i)(canva\.com|designed?\s*(with|in|by)\s*canva|©\s*canva)
confidence: 0.85
action: detect+remove
severity: high
notes: Canva Pro/Free Wasserzeichen

[pattern]
type: text
id: VID-006
name: Filmora Watermark
domain: video
method: regex
pattern: (?i)(filmora\.wondershare|wondershare\s*filmora|made\s*with\s*filmora)
confidence: 0.85
action: detect+remove
severity: high
notes: Filmora Banner am oberen Rand

# ─────────────────────────────────────────────
# SECTION: Generische Copyright-Patterns
# ─────────────────────────────────────────────

[pattern]
type: text
id: GEN-001
name: Generic Copyright Symbol
domain: all
method: regex
pattern: ©\s*\d{4}(?:\s*[-–—]\s*\d{4})?\s+[A-Za-z][\w\s&.,'-]{2,50}
confidence: 0.75
action: detect+flag
severity: medium
notes: Generisches Copyright-Format: © 2024 Company Name

[pattern]
type: text
id: GEN-002
name: Copyright Text Variants
domain: all
method: regex
pattern: (?i)(copyright|copr\.?|©)\s*(\(c\)\s*)?\d{4}\s+\w+
confidence: 0.70
action: detect+flag
severity: medium
notes: Varianten: Copyright 2024, Copr. 2024, (c) 2024

[pattern]
type: text
id: GEN-003
name: All Rights Reserved
domain: all
method: regex
pattern: (?i)all\s+rights?\s+reserved\.?
confidence: 0.65
action: detect+flag
severity: low
notes: Haeufig in Kombination mit Copyright

[pattern]
type: text
id: GEN-004
name: Sample/Preview/Draft Text
domain: all
method: regex
pattern: (?i)\b(SAMPLE|PREVIEW|DRAFT|PROOF|DEMO|TRIAL|EVALUATION|WATERMARK)\b
confidence: 0.80
action: detect+remove
severity: high
notes: Generische Probemarken

[pattern]
type: text
id: GEN-005
name: Rendered/Created With
domain: all
method: regex
pattern: (?i)(rendered|created|made|built|designed|edited|generated|produced|powered)\s*(with|by|in|using)\s+[\w\s]{2,30}
confidence: 0.70
action: detect+flag
severity: medium
notes: App-Attribution: "Made with AppName"

[pattern]
type: text
id: GEN-006
name: Company Inc/LLC/GmbH
domain: all
method: regex
pattern: [A-Z][\w\s&]{1,30}\s+(Inc\.?|LLC|Ltd\.?|GmbH|AG|Corp\.?|Co\.?|SA|SAS|BV|Pty)\.?
confidence: 0.60
action: detect+flag
severity: low
notes: Firmenbezeichnungen in Wasserzeichen

# ─────────────────────────────────────────────
# SECTION: AI-Plattform-Wasserzeichen
# ─────────────────────────────────────────────

[pattern]
type: neural
id: AI-001
name: Google SynthID (Image)
domain: image
method: model
pattern: model:synthid-detector-v3.onnx
confidence: 0.70
action: detect+remove
severity: critical
notes: SynthID Latent-Space Watermark. Removal via Diffusions-Re-Noising.

[pattern]
type: neural
id: AI-002
name: Google SynthID (Audio)
domain: audio
method: model
pattern: model:synthid-audio-detector-v2.onnx
confidence: 0.70
action: detect+remove
severity: critical
notes: SynthID Audio-Wellenform-Marker. Removal via HarmonicAttack Pipeline.

[pattern]
type: neural
id: AI-003
name: Meta Stable Signature
domain: image
method: model
pattern: model:stable-signature-detector-v1.onnx
confidence: 0.75
action: detect+remove
severity: critical
notes: Decoder-Level Diffusion WM. Removal via anderes Diffusionsmodell.

[pattern]
type: neural
id: AI-004
name: Suno V3-V5 Audio Pattern
domain: audio
method: model
pattern: model:suno-neural-wm-detector-v5.onnx
confidence: 0.65
action: detect+remove
severity: critical
notes: 250+ neuronale Signaturen, Multi-Layer-Frequenz. Removal via Multi-Band Spectral Gating + Phase Norm.

[pattern]
type: neural
id: AI-005
name: Udio Audio Fingerprint
domain: audio
method: model
pattern: model:udio-fingerprint-detector-v2.onnx
confidence: 0.65
action: detect+remove
severity: critical
notes: Proprietaerer Fingerprint. Removal via Audio-Autoencoder Passage.

[pattern]
type: neural
id: AI-006
name: Meta AudioSeal
domain: audio
method: model
pattern: model:audioseal-detector-v1.onnx
confidence: 0.75
action: detect+remove
severity: critical
notes: Open Source Detektor verfuegbar. Lokalisierung + Removal.

[pattern]
type: metadata
id: AI-007
name: C2PA Content Credentials
domain: all
method: metadata
pattern: c2pa:manifest|contentcredentials|c2pa\.assertions
confidence: 0.95
action: detect+strip
severity: high
notes: C2PA Provenance Manifest komplett entfernen.

[pattern]
type: metadata
id: AI-008
name: ComfyUI/A1111 Workflow JSON
domain: image
method: metadata
pattern: (prompt|workflow|sampler|cfg_scale|seed|checkpoint|lora)
confidence: 0.80
action: detect+strip
severity: high
notes: AI-Workflow-Parameter in PNG tEXt/iTXt Chunks.

# ─────────────────────────────────────────────
# SECTION: Audio-Frequenz-Patterns
# ─────────────────────────────────────────────

[pattern]
type: frequency
id: FRQ-001
name: High-Freq Inaudible (19-22 kHz)
domain: audio
method: frequency
pattern: band:19000-22000|threshold:0.3|type:persistent
confidence: 0.80
action: detect+remove
severity: high
notes: Unhoerbare Toene ueber 19 kHz. Removal: LPF bei 18.5 kHz.

[pattern]
type: frequency
id: FRQ-002
name: Cinavia-Style Mid-Range (8-12 kHz)
domain: audio
method: frequency
pattern: band:8000-12000|threshold:0.15|type:periodic|period:0.5s
confidence: 0.70
action: detect+flag
severity: critical
notes: Cinavia-aehnliche periodische Muster. Removal: Adaptive Notch + Inpainting.

[pattern]
type: frequency
id: FRQ-003
name: Low-Freq Phase Shift
domain: audio
method: frequency
pattern: band:20-500|threshold:0.1|type:phase_anomaly
confidence: 0.60
action: detect+remove
severity: medium
notes: Phasen-Inkonsistenzen im Bassbereich. Removal: Phase Normalization.

[pattern]
type: frequency
id: FRQ-004
name: Echo Hiding Pattern
domain: audio
method: frequency
pattern: cepstrum:delay_0.5ms-2ms|threshold:0.2
confidence: 0.65
action: detect+remove
severity: medium
notes: Versteckte Echos. Detection via Cepstrum-Analyse. Removal: Deverberation.

# ─────────────────────────────────────────────
# SECTION: Metadata Strip Rules
# ─────────────────────────────────────────────

[pattern]
type: metadata
id: META-001
name: EXIF Complete Strip
domain: image
method: metadata
pattern: exif:*
confidence: 1.00
action: strip
severity: high
notes: ALLE EXIF-Tags entfernen (Kamera, GPS, Datum, etc.)

[pattern]
type: metadata
id: META-002
name: XMP Complete Strip
domain: image
method: metadata
pattern: xmp:*
confidence: 1.00
action: strip
severity: high
notes: ALLE XMP-Tags entfernen (Adobe History, AI-Parameter)

[pattern]
type: metadata
id: META-003
name: IPTC Complete Strip
domain: image
method: metadata
pattern: iptc:*
confidence: 1.00
action: strip
severity: high
notes: ALLE IPTC-Tags entfernen (Agentur, Copyright, Caption)

[pattern]
type: metadata
id: META-004
name: ID3 Complete Strip
domain: audio
method: metadata
pattern: id3:*
confidence: 1.00
action: strip
severity: high
notes: ALLE ID3-Tags entfernen (Artist, Album, Copyright, Cover Art)

[pattern]
type: metadata
id: META-005
name: MP4 Atoms Strip
domain: video
method: metadata
pattern: mp4:udta|mp4:meta|mp4:©*
confidence: 1.00
action: strip
severity: high
notes: ALLE MP4 User-Data und Meta-Atoms entfernen

[pattern]
type: metadata
id: META-006
name: PNG Text Chunks Strip
domain: image
method: metadata
pattern: png:tEXt|png:iTXt|png:zTXt
confidence: 1.00
action: strip
severity: high
notes: ALLE PNG Text-Chunks entfernen (inkl. AI Workflow JSON)

# ─────────────────────────────────────────────
# SECTION: Beat-Loop / Musik-Plattformen
# ─────────────────────────────────────────────

[pattern]
type: text
id: LOOP-001
name: Splice Audio Watermark
domain: audio
method: regex
pattern: (?i)(splice\.com|©\s*splice|splice\s*(sounds?|loops?|samples?))
confidence: 0.80
action: detect+flag
severity: medium
notes: Splice Sample-Attribution in Metadata oder Audio

[pattern]
type: text
id: LOOP-002
name: Loopmasters Watermark
domain: audio
method: regex
pattern: (?i)(loopmasters\.com|©\s*loopmasters|loopmaster)
confidence: 0.80
action: detect+flag
severity: medium
notes: Loopmasters Sample-Pack Branding

[pattern]
type: text
id: LOOP-003
name: Native Instruments
domain: audio
method: regex
pattern: (?i)(native\s*instruments|NI\s*©|kontakt|maschine|battery)
confidence: 0.70
action: detect+flag
severity: medium
notes: Native Instruments Produkt-Branding

[pattern]
type: text
id: LOOP-004
name: Epidemic Sound
domain: audio
method: regex
pattern: (?i)(epidemic\s*sound|epidemicsound\.com|©\s*epidemic)
confidence: 0.80
action: detect+flag
severity: high
notes: Epidemic Sound Lizenz-Wasserzeichen

